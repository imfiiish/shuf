# Copy to .env (gitignored) and adjust for your machine.

# PostgreSQL connection. Defaults to the docker compose service (host port 5433).
# DATABASE_URL=postgres://shuf:shuf@localhost:5433/shuf

# Hono API port (the Vite dev server proxies /api here).
# PORT=8787

# Directory holding the pronunciation audio, laid out as <lang>/<voice>/<file>:
#   $AUDIO_DIR/zh/SeraphinaMultilingualNeural/<sha1>.mp3 -> GET /audio/zh/...
# A relative path resolves against the repo root. Default: ./audio
# AUDIO_DIR=../audio
